# The Neon Auth base URL and JWKS URL are public provider endpoints, not secrets.
NEON_AUTH_BASE_URL=https://<neon-auth-host>/neondb/auth
NEON_AUTH_JWKS_URL=https://<neon-auth-host>/neondb/auth/.well-known/jwks.json
# Set through the deployment secret store for the Postgres-backed account store.
DATABASE_URL=
# Optional overrides when the provider uses different JWT claims.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
